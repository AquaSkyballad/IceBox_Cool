{
    "name": "ESP-IDF QEMU",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "vscode",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "idf.espIdfPath": "/opt/esp/idf",
                "idf.toolsPath": "/opt/esp",
                "idf.gitPath": "/usr/bin/git",
                "cmake.cmakePath": "/opt/esp/tools/cmake/3.30.2/bin/cmake"
            },
            "extensions": [
                "espressif.esp-idf-extension",
                "espressif.esp-idf-web",
                "ms-vscode.cpptools",
                "ms-vscode.cpp-devtools",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cmake-tools",
                "Vizards.deepseek-v4-for-copilot",
                "llvm-vs-code-extensions.vscode-clangd"
            ]
        }
    },
    "runArgs": [
        "--privileged",
        "--network=host"
    ],
    "mounts": [
        "source=/dev,target=/dev,type=bind"
    ],
    "containerEnv": {
        "IDF_PATH": "/opt/esp/idf",
        "IDF_TOOLS_PATH": "/opt/esp",
        "IDF_PYTHON_ENV_PATH": "/opt/esp/python_env/idf5.5_py3.12_env",
        "PATH": "/opt/esp/tools/xtensa-esp-elf-gdb/17.1_20260402/xtensa-esp-elf-gdb/bin:/opt/esp/tools/riscv32-esp-elf-gdb/17.1_20260402/riscv32-esp-elf-gdb/bin:/opt/esp/tools/xtensa-esp-elf/esp-14.2.0_20260121/xtensa-esp-elf/bin:/opt/esp/tools/riscv32-esp-elf/esp-14.2.0_20260121/riscv32-esp-elf/bin:/opt/esp/tools/esp32ulp-elf/2.38_20240113/esp32ulp-elf/bin:/opt/esp/tools/cmake/3.30.2/bin:/opt/esp/tools/openocd-esp32/v0.12.0-esp32-20260424/openocd-esp32/bin:/opt/esp/tools/qemu-xtensa/esp_develop_9.2.2_20260417/qemu/bin:/opt/esp/tools/qemu-riscv32/esp_develop_9.2.2_20260417/qemu/bin:/opt/esp/python_env/idf5.5_py3.12_env/bin:/opt/esp/idf/tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    }
}